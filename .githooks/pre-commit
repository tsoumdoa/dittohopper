#!/bin/sh
# DittoHopper pre-commit hook: the local replacement for cloud CI.
# Builds the solution and runs the Rhino-free tests when a commit touches code; docs-only commits skip it.
# Enable once per clone:  git config core.hooksPath .githooks
# Force a run without code changes:  DITTOHOPPER_HOOK_FORCE=1 git commit ...
# It builds the working tree, so unstaged edits are included in what gets checked.

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
if [ -z "$DITTOHOPPER_HOOK_FORCE" ] && ! printf '%s\n' "$staged" | grep -qE '\.(cs|csproj|props|targets|sln|json)$'; then
  echo "pre-commit: no code changes, skipping build + test."
  exit 0
fi
if ! command -v dotnet >/dev/null 2>&1; then
  echo "pre-commit: dotnet not found on PATH." >&2
  exit 1
fi
root=$(git rev-parse --show-toplevel) || exit 1
start=$(date +%s)
echo "pre-commit: dotnet build ..."
if ! dotnet build "$root/DittoHopper.sln" -c Debug -v q -nologo; then
  echo "pre-commit: build failed (warnings are errors). Commit aborted." >&2
  exit 1
fi
echo "pre-commit: dotnet test (Rhino-free) ..."
if ! dotnet test "$root/DittoHopper.sln" -c Debug --no-build -v q -nologo; then
  echo "pre-commit: tests failed. Commit aborted." >&2
  exit 1
fi
echo "pre-commit: build + tests passed in $(( $(date +%s) - start ))s."
